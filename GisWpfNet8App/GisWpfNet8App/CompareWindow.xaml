<Window x:Class="GisWpfApp.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設施比對"
        Width="620" Height="340"
        MinWidth="440" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="White"
        FontFamily="Microsoft JhengHei"
        FontSize="9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgCompare"
                  Grid.Row="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#DCDCE1"
                  BorderThickness="0"
                  Background="White"
                  IsReadOnly="True"
                  RowHeight="28"
                  AlternatingRowBackground="#F6F8FC">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"                  Value="#0070CC"/>
                    <Setter Property="Foreground"                  Value="White"/>
                    <Setter Property="FontWeight"                  Value="Bold"/>
                    <Setter Property="FontFamily"                  Value="Microsoft JhengHei"/>
                    <Setter Property="FontSize"                    Value="9"/>
                    <Setter Property="Height"                      Value="32"/>
                    <Setter Property="Padding"                     Value="8,0,8,0"/>
                    <Setter Property="HorizontalContentAlignment"  Value="Left"/>
                    <Setter Property="BorderThickness"             Value="0,0,1,0"/>
                    <Setter Property="BorderBrush"                 Value="#1C8CEE"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                            <Setter Property="Background" Value="#FFF5DC"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- 欄位名稱欄：固定灰底粗體 -->
                <DataGridTextColumn Header="欄位" Binding="{Binding Field}" Width="0.75*">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background"     Value="#F0F2F6"/>
                            <Setter Property="FontWeight"     Value="Bold"/>
                            <Setter Property="Foreground"     Value="#464646"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding"        Value="8,4"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- 設施 A 值欄：差異時橘紅粗體 -->
                <DataGridTextColumn Header="A" Binding="{Binding ValueA}" Width="*">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding"         Value="8,4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="#B03C00"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <!-- 設施 B 值欄：差異時橘紅粗體 -->
                <DataGridTextColumn Header="B" Binding="{Binding ValueB}" Width="*">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding"         Value="8,4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                    <Setter Property="Foreground" Value="#B03C00"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部關閉列 -->
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                BorderBrush="#E0E0E0">
            <Button Content="關閉"
                    Width="80" Height="28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0"
                    Click="btnClose_Click"
                    FontFamily="Microsoft JhengHei"
                    FontSize="9"/>
        </Border>
    </Grid>
</Window>
